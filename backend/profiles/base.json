      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": { "baseURL": "https://integrate.api.nvidia.com/v1", "apiKey": "proxy-managed" },
      "models": {
        "nvidia/llama-3.1-nemotron-70b-instruct": {
          "modelID": "nvidia/llama-3.1-nemotron-70b-instruct",
