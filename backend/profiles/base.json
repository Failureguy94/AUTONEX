      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": { "baseURL": "https://api.groq.com/openai/v1", "apiKey": "proxy-managed" },
      "models": {
        "openai/gpt-oss-120b": {
          "modelID": "openai/gpt-oss-120b",
