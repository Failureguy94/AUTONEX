# true  = built-in mock simulator (default)
# false = talk to the real AUTONEX Bridge Server
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8000
VITE_ZG_BASE_URL=https://router-api.0g.ai/v1

# Arkiv Network (Rabdi DB-Chain Testnet, Chain ID 7794095)
# Optional for public reads; required for higher-rate access and wallet writes.
VITE_ARKIV_ACCESS_KEY=

# Ethereum Swarm (BZZ Content-Addressed Storage)
VITE_SWARM_GATEWAY_URL=https://api.gateway.ethswarm.org
VITE_SWARM_POSTAGE_BATCH_ID=
VITE_SWARM_TIMEOUT_MS=15000

# ENSv2 browser integration (Ethereum Sepolia, chain 11155111)
# A public RPC is provided for local development. Replace it with a
# provider-owned Sepolia RPC for production use.
VITE_ENS_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Required for one-click identity creation. This must be a real .eth parent
# namespace controlled by the connected Sepolia wallet; never use autonex.eth
# unless that wallet actually owns and manages it.
VITE_ENS_PARENT_NAME=
# Optional Arkiv adapter endpoint for application-level ENS references only.
# Leave blank to use the native Arkiv wallet client on Rabdi.
VITE_ARKIV_ENS_ENDPOINT=
