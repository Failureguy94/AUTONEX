# ==============================================================================
# AUTONEX Unified Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend (AUTONEX 3D Virtual Office)
# ------------------------------------------------------------------------------
# Set to 'true' to run fully offline/client-side with synthetic agent simulation.
# Set to 'false' to connect to the Bridge Server over HTTP & WebSocket.
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. Bridge & Provider Gateway (Local Proxy)
# ------------------------------------------------------------------------------
# Bridge HTTP/WebSocket server port
PORT=8000
# Gateway OpenAI-compatible proxy port
GATEWAY_PORT=8787
AUTONEX_BRIDGE=http://127.0.0.1:8787

# ------------------------------------------------------------------------------
# 3. Model Provider Keys (0G Private Computer Primary)
# ------------------------------------------------------------------------------
# 0G Private Computer (0G Compute) - Unified Decentralized AI Router
# Official Base URL: https://router-api.0g.ai/v1 (OpenAI-compatible)
# Verified Catalog: 79 models (GLM 5.3 Flash, Qwen 3 Coder Flash, Kimi K2.7, DeepSeek V4.1)
ZG_API_KEY=
ZG_BASE_URL=https://router-api.0g.ai/v1
ZG_TRUST_MODE=standard       # standard | verified | private
ZG_TIMEOUT_MS=65000

# Legacy Secondary Fallback Providers:
# Groq - Fastest inference, free tier (console.groq.com/keys)
GROQ_API_KEY=

# OpenRouter - Free open-weight models with :free tag (openrouter.ai/keys)
OPENROUTER_API_KEY=

# NVIDIA NIM - Free credits for prototyping (build.nvidia.com)
NVIDIA_API_KEY=

# OpenCode Go - Free tier window (opencode.ai/v2/docs/console/go)
GO_API_KEY=

# Optional Extra Providers:
# GOOGLE_AI_STUDIO_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=

# ------------------------------------------------------------------------------
# 4. AUTONEX / PAG Autonomous Engine Settings
# ------------------------------------------------------------------------------
# Context tier: 1 (aggressive mask), 2 (moderate), 3 (conservative - default)
PAG_CTX_TIER=3

# Optional local/hosted SearXNG instance for autonomous web search
SEARXNG_URL=
